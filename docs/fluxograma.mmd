flowchart TD
  a["Pedido da Larissa<br/>ex.: 5 negócios com<br/>tag Resgate Novembro"] --> b["Pesquisa os negócios<br/>na Clint"]
  b --> c["Puxa as informações:<br/>cadastro, dor, quando foi<br/>atendido, conversas"]
  c --> d["Identifica o anúncio<br/>que converteu<br/>(utm_content)"]
  d --> e{"Anúncio já<br/>guardado?"}
  e -->|"sim"| j
  e -->|"não"| f["Procura no Drive<br/>e baixa"]
  f --> g{"Formato?"}
  g -->|"estático ou<br/>carrossel"| h["Lê a copy<br/>das imagens"]
  g -->|"vídeo"| i["Transcreve<br/>o vídeo"]
  h --> k["Guarda a copy<br/>e a análise"]
  i --> k
  k --> j["Claude junta: conversa +<br/>negócio + copy do anúncio"]
  j --> l["Escreve a mensagem<br/>com base nos exemplos<br/>da Larissa"]
  l --> m{"Larissa<br/>aprova?"}
  m -->|"não"| n["Refaz com<br/>o feedback"]
  n --> l
  m -->|"sim"| o{"Pediu para<br/>enviar pela Clint?"}
  o -->|"sim"| p["Claude envia<br/>pela Clint"]
  o -->|"não"| q["Larissa envia"]

  classDef decisao fill:#fff8e1,stroke:#b8860b,color:#111
  classDef fim fill:#eaf5ec,stroke:#2e7d32,color:#111
  class e,g,m,o decisao
  class p,q fim
